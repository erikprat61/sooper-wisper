{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sooper-wisper",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sooper-Wisper",
        "width": 620,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": true,
        "focusable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false
      },
      {
        "label": "settings",
        "title": "Sooper-Wisper Settings",
        "width": 1100,
        "height": 760,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "focusable": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
